{
  "name": "asternihva-adv-engine",
  "version": "0.1.0",
  "description": "A small, renderer-agnostic visual novel and ADV engine.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./web": {
      "types": "./dist/web.d.ts",
      "import": "./dist/web.js"
    },
    "./live2d": {
      "types": "./dist/live2d.d.ts",
      "import": "./dist/live2d.js"
    },
    "./tooling": {
      "types": "./dist/tooling/index.d.ts",
      "import": "./dist/tooling/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "scripts/cli.mjs"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run build && npm test",
    "pack:smoke": "npm run build && node scripts/package-smoke.mjs",
    "serve:example": "python3 -m http.server 4173 --bind 127.0.0.1",
    "validate:scenarios": "npm run build && node scripts/validate-scenarios.mjs",
    "assets": "npm run build && node scripts/cli.mjs asset build"
  },
  "keywords": [
    "visual-novel",
    "adv",
    "web",
    "typescript",
    "game-engine"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Twil3akine/asternihva-adv-engine.git"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "sharp": "^0.34.5",
    "typescript": "^5.8.3"
  },
  "bin": {
    "asternihva-adv-engine": "./scripts/cli.mjs"
  },
  "peerDependencies": {
    "sharp": "^0.34.0"
  },
  "peerDependenciesMeta": {
    "sharp": {
      "optional": true
    }
  }
}
