{
  "types": "./dist/index.d.ts",
  "bin": {
    "asternihva-adv-engine": "./scripts/cli.mjs"
  },
  "main": "./dist/index.js",
  "keywords": [
    "visual-novel",
    "adv",
    "web",
    "typescript",
    "game-engine"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.25.12",
    "playwright": "^1.61.0",
    "sharp": "^0.34.5",
    "typescript": "^5.8.3"
  },
  "type": "module",
  "peerDependenciesMeta": {
    "sharp": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "version": "0.1.0",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "scripts/cli.mjs"
  ],
  "name": "asternihva-adv-engine",
  "repository": {
    "type": "git",
    "url": "https://github.com/Twil3akine/asternihva-adv-engine.git"
  },
  "description": "A small, renderer-agnostic visual novel and ADV engine.",
  "sideEffects": false,
  "peerDependencies": {
    "sharp": "^0.34.0",
    "typescript": "^5.8.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./web": {
      "types": "./dist/web.d.ts",
      "import": "./dist/web.js"
    },
    "./live2d": {
      "types": "./dist/live2d.d.ts",
      "import": "./dist/live2d.js"
    },
    "./tooling": {
      "types": "./dist/tooling/index.d.ts",
      "import": "./dist/tooling/index.js"
    }
  },
  "scripts": {
    "check": "npm run build && npm test",
    "validate:fixture": "node scripts/validate-fixture.mjs",
    "pack:smoke": "npm run build && node scripts/package-smoke.mjs",
    "verify:core": "node scripts/verify-core.mjs",
    "test": "node --test tests/*.test.mjs",
    "serve:example": "python3 -m http.server 4173 --bind 127.0.0.1",
    "build": "node scripts/build.mjs",
    "browser:test": "node tests/browser-smoke.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "assets": "npm run build && node scripts/cli.mjs asset build",
    "smoke:runtime": "node scripts/compatibility-smoke.mjs",
    "verify:boundary": "node scripts/public-boundary.mjs",
    "consumer:test": "node tests/consumer-e2e.mjs",
    "mobile:test": "node tests/mobile-e2e.mjs"
  }
}
