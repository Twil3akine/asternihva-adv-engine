{
  "name": "asternihva-adv-engine",
  "version": "0.1.0",
  "description": "A small, renderer-agnostic visual novel and ADV engine.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./web": {
      "types": "./dist/web.d.ts",
      "import": "./dist/web.js"
    },
    "./live2d": {
      "types": "./dist/live2d.d.ts",
      "import": "./dist/live2d.js"
    },
    "./tooling": {
      "types": "./dist/tooling/scenario-validator.d.ts",
      "import": "./dist/tooling/scenario-validator.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run build && npm test",
    "pack:smoke": "npm run build && node scripts/package-smoke.mjs",
    "serve:example": "python3 -m http.server 4173 --bind 127.0.0.1",
    "validate:scenarios": "npm run build && node scripts/validate-scenarios.mjs",
    "verify:core": "node scripts/verify-core.mjs",
    "validate:fixture": "node scripts/validate-fixture.mjs",
    "smoke:runtime": "node scripts/compatibility-smoke.mjs",
    "browser:test": "node tests/browser-smoke.mjs"
  },
  "keywords": [
    "visual-novel",
    "adv",
    "web",
    "typescript",
    "game-engine"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Twil3akine/asternihva-adv-engine.git"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "playwright": "^1.61.0",
    "typescript": "^5.8.3"
  }
}
