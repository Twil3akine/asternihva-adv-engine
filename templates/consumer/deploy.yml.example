# Inactive example: copy into a PRIVATE consumer only after deployment approval.
name: Manual game deployment
on:
  workflow_dispatch:
permissions:
  contents: read
concurrency:
  group: production-game
  cancel-in-progress: false
jobs:
  deploy:
    runs-on: ubuntu-latest
    environment: production
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: npm
      - run: npm ci
      - run: npm run typecheck
      - run: npm test
      - run: npm run build
      - run: npm run browser:test
      - run: node release-check.mjs dist
      # Install and lock Wrangler in the consumer; do not fetch latest at deploy time.
      - run: npx --no-install wrangler deploy --config wrangler.jsonc
        env:
          CLOUDFLARE_API_TOKEN: ${{ secrets.CLOUDFLARE_API_TOKEN }}
          CLOUDFLARE_ACCOUNT_ID: ${{ secrets.CLOUDFLARE_ACCOUNT_ID }}
